# Copy to .env and fill in your values for local development.
# In Railway, set these in the service Variables panel instead.

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Server port (Railway sets this automatically; 3000 is fine locally)
PORT=3000
